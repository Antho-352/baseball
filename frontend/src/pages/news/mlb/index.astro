---
/**
 * MLB News Page
 * News filtered for MLB only
 */
import BaseLayout from '@layouts/BaseLayout.astro';

// Mock data - will use content collection
const mockArticles = [
  {
    id: '1',
    title: 'Les Yankees remportent une victoire éclatante face aux Red Sox',
    slug: 'yankees-victoire-red-sox',
    excerpt: 'Aaron Judge et Juan Soto brillent dans une victoire dominante 8-2 au Yankee Stadium.',
    category: 'Résultats',
    publishedAt: '2026-04-15',
    image: '/images/news/placeholder.jpg',
  },
];

const title = 'Actualités MLB : News et Résultats Major League Baseball';
const description = 'Toutes les actualités MLB : résultats, transferts, blessures, analyses de la Major League Baseball.';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">Actualités MLB</h1>
      <p class="page-description">Dernières news de la Major League Baseball</p>
    </header>

    <div class="articles-grid">
      {mockArticles.map((article) => (
        <article class="article-card">
          <div class="article-image">
            <img src={article.image} alt={article.title} loading="lazy" />
          </div>
          <div class="article-content">
            <span class="article-category">{article.category}</span>
            <h3 class="article-title">
              <a href={`/news/${article.slug}/`}>{article.title}</a>
            </h3>
            <p class="article-excerpt">{article.excerpt}</p>
            <span class="article-date">
              {new Date(article.publishedAt).toLocaleDateString('fr-FR')}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
    text-align: center;
  }
  .page-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }
  .page-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .article-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .article-image {
    height: 200px;
  }
  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-content {
    padding: var(--space-4);
  }
  .article-category {
    display: inline-block;
    padding: 4px 8px;
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }
  .article-title a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
  }
  .article-excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: var(--space-2) 0;
  }
  .article-date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
