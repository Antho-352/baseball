---
/**
 * News Hub Page
 * Main news page with latest articles from all leagues
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch articles from content collection (when implemented)
// For now, using mock data
const mockArticles = [
  {
    id: '1',
    title: 'Les Yankees remportent une victoire éclatante face aux Red Sox',
    slug: 'yankees-victoire-red-sox',
    excerpt: 'Aaron Judge et Juan Soto brillent dans une victoire dominante 8-2 au Yankee Stadium.',
    category: 'Résultats',
    league: 'mlb',
    publishedAt: '2026-04-15',
    image: '/images/news/placeholder.jpg',
    featured: true
  },
  {
    id: '2',
    title: 'Shohei Ohtani établit un nouveau record de home runs en début de saison',
    slug: 'ohtani-record-home-runs',
    excerpt: 'Le joueur des Dodgers frappe son 15e home run, un record pour le mois d\'avril.',
    category: 'Performance',
    league: 'mlb',
    publishedAt: '2026-04-14',
    image: '/images/news/placeholder.jpg',
    featured: false
  },
  {
    id: '3',
    title: 'KBO : Les Landers remontent au classement après 5 victoires consécutives',
    slug: 'kbo-landers-serie-victoires',
    excerpt: 'SSG Landers impressionne avec une série de 5 victoires d\'affilée.',
    category: 'Classement',
    league: 'kbo',
    publishedAt: '2026-04-14',
    image: '/images/news/placeholder.jpg',
    featured: false
  },
  {
    id: '4',
    title: 'Blessure majeure : Mike Trout manquera 4-6 semaines',
    slug: 'mike-trout-blessure',
    excerpt: 'L\'Angels annonce une blessure au genou pour sa star, un coup dur pour l\'équipe.',
    category: 'Blessures',
    league: 'mlb',
    publishedAt: '2026-04-13',
    image: '/images/news/placeholder.jpg',
    featured: false
  },
];

const title = 'Actualités Baseball : MLB, KBO, NPB - News et Analyses';
const description = 'Toutes les actualités baseball : résultats, transferts, blessures, analyses. Suivez MLB, KBO et NPB en temps réel sur home-run.fr.';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <!-- Header -->
    <header class="page-header">
      <h1 class="page-title">Actualités Baseball</h1>
      <p class="page-description">
        Dernières news, analyses et résultats de MLB, KBO et NPB
      </p>
    </header>

    <!-- Category Filters -->
    <div class="category-filters">
      <button class="category-btn category-btn--active">
        Toutes
      </button>
      <button class="category-btn">
        Résultats
      </button>
      <button class="category-btn">
        Transferts
      </button>
      <button class="category-btn">
        Blessures
      </button>
      <button class="category-btn">
        Analyses
      </button>
    </div>

    <!-- League Tabs -->
    <div class="league-tabs">
      <a href="/news/" class="league-tab league-tab--active">
        Toutes
      </a>
      <a href="/news/mlb/" class="league-tab">
        🇺🇸 MLB
      </a>
      <a href="/news/kbo/" class="league-tab">
        🇰🇷 KBO
      </a>
      <a href="/news/npb/" class="league-tab">
        🇯🇵 NPB
      </a>
    </div>

    <!-- Featured Article -->
    {mockArticles.filter(a => a.featured).map((article) => (
      <article class="featured-article">
        <div class="featured-image">
          <img src={article.image} alt={article.title} loading="eager" />
          <span class="featured-badge">À la une</span>
        </div>
        <div class="featured-content">
          <div class="featured-meta">
            <span class="article-category">{article.category}</span>
            <span class="article-league">{article.league.toUpperCase()}</span>
            <span class="article-date">
              {new Date(article.publishedAt).toLocaleDateString('fr-FR', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
              })}
            </span>
          </div>
          <h2 class="featured-title">
            <a href={`/news/${article.slug}/`}>{article.title}</a>
          </h2>
          <p class="featured-excerpt">{article.excerpt}</p>
          <a href={`/news/${article.slug}/`} class="read-more">
            Lire l'article →
          </a>
        </div>
      </article>
    ))}

    <!-- Articles Grid -->
    <div class="articles-grid">
      {mockArticles.filter(a => !a.featured).map((article) => (
        <article class="article-card">
          <div class="article-image">
            <img src={article.image} alt={article.title} loading="lazy" />
          </div>
          <div class="article-content">
            <div class="article-meta">
              <span class="article-category">{article.category}</span>
              <span class="article-league">{article.league.toUpperCase()}</span>
            </div>
            <h3 class="article-title">
              <a href={`/news/${article.slug}/`}>{article.title}</a>
            </h3>
            <p class="article-excerpt">{article.excerpt}</p>
            <div class="article-footer">
              <span class="article-date">
                {new Date(article.publishedAt).toLocaleDateString('fr-FR', {
                  day: 'numeric',
                  month: 'short'
                })}
              </span>
              <a href={`/news/${article.slug}/`} class="read-more-small">
                Lire →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Load More -->
    <div class="load-more">
      <button class="load-more-btn">
        Charger plus d'articles
      </button>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
    text-align: center;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .category-filters {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    overflow-x: auto;
  }

  .category-btn {
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  .category-btn:hover {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .category-btn--active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .league-tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
  }

  .league-tab {
    flex: 1;
    padding: var(--space-3);
    text-align: center;
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .league-tab:hover {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .league-tab--active {
    background: var(--color-primary);
    color: white;
  }

  .featured-article {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-8);
  }

  .featured-image {
    position: relative;
    height: 400px;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-badge {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--color-error);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    border-radius: var(--radius-md);
  }

  .featured-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-meta {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .featured-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .featured-title a:hover {
    color: var(--color-primary);
  }

  .featured-excerpt {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .article-category {
    padding: 4px 8px;
    background: var(--color-bg);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .article-league {
    padding: 4px 8px;
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-sm);
  }

  .article-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .read-more {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background: var(--color-primary);
    color: white;
    font-weight: var(--font-semibold);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .read-more:hover {
    background: var(--color-secondary);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .article-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .article-image {
    height: 200px;
    overflow: hidden;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .article-card:hover .article-image img {
    transform: scale(1.05);
  }

  .article-content {
    padding: var(--space-4);
  }

  .article-meta {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .article-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    line-height: 1.3;
    margin-bottom: var(--space-3);
  }

  .article-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .article-title a:hover {
    color: var(--color-primary);
  }

  .article-excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .article-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .read-more-small {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .read-more-small:hover {
    text-decoration: underline;
  }

  .load-more {
    text-align: center;
  }

  .load-more-btn {
    padding: var(--space-3) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .load-more-btn:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .featured-article {
      grid-template-columns: 1fr;
    }

    .featured-image {
      height: 300px;
    }

    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-3xl);
    }

    .featured-title {
      font-size: var(--text-2xl);
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .league-tabs {
      flex-wrap: wrap;
    }
  }
</style>
