---
/**
 * KBO Team Detail Page
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getKBOLogo } from '@lib/constants/logos';

export async function getStaticPaths() {
  const kboTeams = [
    { name: 'SSG Landers', slug: 'ssg-landers', city: 'Incheon', stadium: 'Incheon SSG Landers Field', founded: 2000 },
    { name: 'LG Twins', slug: 'lg-twins', city: 'Seoul', stadium: 'Jamsil Baseball Stadium', founded: 1982 },
    { name: 'Samsung Lions', slug: 'samsung-lions', city: 'Daegu', stadium: 'Daegu Samsung Lions Park', founded: 1982 },
    { name: 'KIA Tigers', slug: 'kia-tigers', city: 'Gwangju', stadium: 'Gwangju-Kia Champions Field', founded: 1982 },
    { name: 'Doosan Bears', slug: 'doosan-bears', city: 'Seoul', stadium: 'Jamsil Baseball Stadium', founded: 1982 },
    { name: 'Kiwoom Heroes', slug: 'kiwoom-heroes', city: 'Seoul', stadium: 'Gocheok Sky Dome', founded: 2008 },
    { name: 'Lotte Giants', slug: 'lotte-giants', city: 'Busan', stadium: 'Sajik Baseball Stadium', founded: 1982 },
    { name: 'NC Dinos', slug: 'nc-dinos', city: 'Changwon', stadium: 'Changwon NC Park', founded: 2011 },
    { name: 'Hanwha Eagles', slug: 'hanwha-eagles', city: 'Daejeon', stadium: 'Hanwha Life Eagles Park', founded: 1986 },
    { name: 'KT Wiz', slug: 'kt-wiz', city: 'Suwon', stadium: 'Suwon KT Wiz Park', founded: 2013 },
  ];

  return kboTeams.map(team => ({
    params: { slug: team.slug },
    props: { team }
  }));
}

const { team } = Astro.props;

const title = `${team.name} : Roster, Stats et Actualités KBO`;
const description = `Page officielle ${team.name} : effectif complet, statistiques de la saison KBO et dernières actualités.`;
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <header class="team-header">
      <div class="team-logo-large">
        <img src={getKBOLogo(team.name)} alt={team.name} />
      </div>
      <div class="team-header-info">
        <h1 class="team-name">{team.name}</h1>
        <div class="team-meta">
          <span>🏟️ {team.stadium}</span>
          <span>📍 {team.city}</span>
          <span>📅 Fondée en {team.founded}</span>
        </div>
      </div>
    </header>

    <div class="team-layout">
      <main class="team-main">
        <section class="team-section">
          <h2 class="section-title">Informations</h2>
          <div class="info-grid">
            <div class="info-item">
              <dt>Ville</dt>
              <dd>{team.city}</dd>
            </div>
            <div class="info-item">
              <dt>Stade</dt>
              <dd>{team.stadium}</dd>
            </div>
            <div class="info-item">
              <dt>Fondation</dt>
              <dd>{team.founded}</dd>
            </div>
          </div>
        </section>

        <section class="team-section">
          <h2 class="section-title">Statistiques saison 2026</h2>
          <div class="stats-placeholder">
            <p>Statistiques et roster à venir...</p>
            <p class="stats-note">Les données KBO seront intégrées via TheSportsDB API.</p>
          </div>
        </section>
      </main>

      <aside class="team-sidebar">
        <div class="widget">
          <h3 class="widget-title">Liens rapides</h3>
          <div class="widget-content">
            <nav class="quick-links">
              <a href="/kbo/classement/">Classement KBO</a>
              <a href="/kbo/scores/">Scores en direct</a>
              <a href="/news/kbo/">Actualités KBO</a>
            </nav>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .team-header {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .team-logo-large {
    width: 120px;
    height: 120px;
  }

  .team-logo-large img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .team-name {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .team-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-6);
  }

  .team-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-border);
  }

  .info-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .info-item {
    display: flex;
    justify-content: space-between;
    padding: var(--space-3);
    background: var(--color-bg);
    border-radius: var(--radius-md);
  }

  .info-item dt {
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
  }

  .info-item dd {
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .stats-placeholder {
    padding: var(--space-8);
    text-align: center;
    color: var(--color-text-muted);
  }

  .stats-note {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .widget {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
  }

  .widget-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .quick-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .quick-links a {
    padding: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
  }

  .quick-links a:hover {
    background: var(--color-bg);
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .team-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .team-header {
      flex-direction: column;
      text-align: center;
    }

    .team-name {
      font-size: var(--text-2xl);
    }
  }
</style>
