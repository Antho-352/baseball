---
/**
 * KBO Teams List Page
 * Lists all 10 KBO teams
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getKBOLogo } from '@lib/constants/logos';

// KBO teams (10 teams)
const kboTeams = [
  { name: 'SSG Landers', slug: 'ssg-landers', city: 'Incheon' },
  { name: 'LG Twins', slug: 'lg-twins', city: 'Seoul' },
  { name: 'Samsung Lions', slug: 'samsung-lions', city: 'Daegu' },
  { name: 'KIA Tigers', slug: 'kia-tigers', city: 'Gwangju' },
  { name: 'Doosan Bears', slug: 'doosan-bears', city: 'Seoul' },
  { name: 'Kiwoom Heroes', slug: 'kiwoom-heroes', city: 'Seoul' },
  { name: 'Lotte Giants', slug: 'lotte-giants', city: 'Busan' },
  { name: 'NC Dinos', slug: 'nc-dinos', city: 'Changwon' },
  { name: 'Hanwha Eagles', slug: 'hanwha-eagles', city: 'Daejeon' },
  { name: 'KT Wiz', slug: 'kt-wiz', city: 'Suwon' },
];

const title = 'Équipes KBO : Toutes les franchises de la Korean Baseball Organization';
const description = 'Découvrez les 10 équipes de la KBO League : statistiques, rosters, calendriers et actualités de chaque franchise.';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">Équipes KBO</h1>
      <p class="page-description">
        Les 10 franchises de la Korean Baseball Organization
      </p>
    </header>

    <div class="teams-grid">
      {kboTeams.map((team) => (
        <a href={`/kbo/equipes/${team.slug}/`} class="team-card">
          <div class="team-logo">
            <img src={getKBOLogo(team.name)} alt={team.name} loading="lazy" />
          </div>
          <div class="team-info">
            <h3 class="team-name">{team.name}</h3>
            <p class="team-city">{team.city}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .teams-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .team-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .team-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .team-logo {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
  }

  .team-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .team-info {
    flex: 1;
  }

  .team-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .team-city {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .teams-grid {
      grid-template-columns: 1fr;
    }

    .page-title {
      font-size: var(--text-3xl);
    }
  }
</style>
