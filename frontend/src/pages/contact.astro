---
/**
 * Contact Page
 */
import BaseLayout from '@layouts/BaseLayout.astro';

const title = 'Contact - home-run.fr';
const description = 'Contactez l\'équipe de home-run.fr pour toute question, suggestion ou demande de partenariat.';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <div class="contact-page">
      <header class="contact-header">
        <h1>Contactez-nous</h1>
        <p class="header-description">
          Une question, une suggestion, une demande de partenariat ? N'hésitez pas à nous contacter.
        </p>
      </header>

      <div class="contact-layout">
        <!-- Contact Form -->
        <div class="contact-form-wrapper">
          <form class="contact-form" action="#" method="POST">
            <div class="form-group">
              <label for="name">Nom et prénom <span class="required">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Votre nom complet"
              />
            </div>

            <div class="form-group">
              <label for="email">Email <span class="required">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="votre@email.fr"
              />
            </div>

            <div class="form-group">
              <label for="subject">Sujet <span class="required">*</span></label>
              <select id="subject" name="subject" required>
                <option value="">Sélectionnez un sujet</option>
                <option value="question">Question générale</option>
                <option value="partnership">Demande de partenariat</option>
                <option value="content">Suggestion de contenu</option>
                <option value="bug">Signaler un bug</option>
                <option value="rgpd">Demande RGPD (accès/suppression données)</option>
                <option value="other">Autre</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message <span class="required">*</span></label>
              <textarea
                id="message"
                name="message"
                rows="8"
                required
                placeholder="Votre message..."
              ></textarea>
            </div>

            <div class="form-notice">
              <p>
                <strong>Note :</strong> En soumettant ce formulaire, vous acceptez que vos données
                soient traitées conformément à notre
                <a href="/politique-confidentialite/">Politique de Confidentialité</a>.
              </p>
            </div>

            <button type="submit" class="submit-btn">
              Envoyer le message
            </button>
          </form>

          <div class="form-info">
            <p>
              <strong>Délai de réponse :</strong> Nous nous efforçons de répondre sous 48h ouvrées.
            </p>
          </div>
        </div>

        <!-- Contact Info Sidebar -->
        <aside class="contact-sidebar">
          <!-- Email -->
          <div class="contact-card">
            <div class="card-icon">✉️</div>
            <h3 class="card-title">Email</h3>
            <p class="card-content">
              <a href="mailto:contact@home-run.fr">contact@home-run.fr</a>
            </p>
            <p class="card-note">Réponse sous 48h ouvrées</p>
          </div>

          <!-- Demandes RGPD -->
          <div class="contact-card">
            <div class="card-icon">🔒</div>
            <h3 class="card-title">Demandes RGPD</h3>
            <p class="card-content">
              Pour toute demande d'accès, de rectification ou de suppression de vos données
              personnelles, envoyez un email à :
            </p>
            <p class="card-email">
              <a href="mailto:contact@home-run.fr?subject=Demande%20RGPD">contact@home-run.fr</a>
            </p>
            <p class="card-note">
              Joindre une copie de votre pièce d'identité
            </p>
          </div>

          <!-- Partenariats -->
          <div class="contact-card">
            <div class="card-icon">🤝</div>
            <h3 class="card-title">Partenariats</h3>
            <p class="card-content">
              Intéressé par un partenariat ou une collaboration ?
            </p>
            <p class="card-email">
              <a href="mailto:contact@home-run.fr?subject=Demande%20de%20partenariat">contact@home-run.fr</a>
            </p>
          </div>

          <!-- FAQ -->
          <div class="contact-card">
            <div class="card-icon">❓</div>
            <h3 class="card-title">Questions fréquentes</h3>
            <ul class="faq-list">
              <li>
                <strong>Les pronostics sont-ils gratuits ?</strong>
                Oui, tous nos pronostics sont gratuits.
              </li>
              <li>
                <strong>D'où viennent les statistiques ?</strong>
                MLB: statsapi.mlb.com (officiel). KBO/NPB: TheSportsDB.
              </li>
              <li>
                <strong>Puis-je utiliser vos contenus ?</strong>
                Non, sauf autorisation écrite préalable.
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding: var(--space-8) 0;
  }

  .contact-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .contact-header h1 {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .header-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-8);
  }

  /* Contact Form */
  .contact-form-wrapper {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-group label {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .required {
    color: var(--color-error);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    color: var(--color-text);
    font-family: inherit;
    transition: border-color var(--transition-base);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 150px;
  }

  .form-notice {
    padding: var(--space-3);
    background: var(--color-bg);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .form-notice a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .submit-btn {
    padding: var(--space-3) var(--space-6);
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .submit-btn:hover {
    background: var(--color-secondary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .form-info {
    margin-top: var(--space-4);
    padding: var(--space-3);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .card-icon {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .card-content {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-2);
  }

  .card-email {
    margin: var(--space-2) 0;
  }

  .card-email a {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    text-decoration: underline;
  }

  .card-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .faq-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-list li {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .faq-list strong {
    display: block;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }

    .contact-sidebar {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .contact-page {
      padding: var(--space-6) 0;
    }

    .contact-header h1 {
      font-size: var(--text-3xl);
    }

    .contact-form-wrapper {
      padding: var(--space-4);
    }
  }
</style>

<script>
  // Form handling (will be connected to backend later)
  const form = document.querySelector('.contact-form');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // TODO: Connect to backend API
      alert('Formulaire de contact à connecter au backend. Envoyez un email à contact@home-run.fr pour le moment.');
    });
  }
</script>
