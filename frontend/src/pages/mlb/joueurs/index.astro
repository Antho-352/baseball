---
/**
 * MLB Players List Page
 * Lists top 200 star players
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getMLBLogo } from '@lib/constants/logos';

// Fetch featured players (will be replaced with DB query for 200 stars)
async function fetchFeaturedPlayers() {
  try {
    // For V1: Hardcode some star players IDs
    // Later: Query from DB where is_star = true
    const starPlayerIds = [
      660271, // Shohei Ohtani
      592450, // Aaron Judge
      665742, // Juan Soto
      608070, // Ronald Acuña Jr.
      608369, // Mookie Betts
      645302, // Francisco Lindor
      545361, // Mike Trout
      621020, // José Ramírez
      660670, // Bobby Witt Jr.
      665487, // Julio Rodríguez
      660271, // Fernando Tatis Jr.
      645277, // Freddie Freeman
      656941, // Corbin Carroll
      663993, // Gunnar Henderson
      624413, // Rafael Devers
    ];

    const players = await Promise.all(
      starPlayerIds.map(async (playerId) => {
        try {
          const res = await fetch(`https://statsapi.mlb.com/api/v1/people/${playerId}?hydrate=currentTeam,stats(type=season,season=2026)`);
          const data = await res.json();
          return data.people?.[0] || null;
        } catch {
          return null;
        }
      })
    );

    return players.filter(Boolean);
  } catch (error) {
    console.error('Failed to fetch players:', error);
    return [];
  }
}

const players = await fetchFeaturedPlayers();

const title = 'Joueurs MLB : Les stars de la Major League Baseball';
const description = 'Découvrez les 200 meilleurs joueurs MLB : statistiques, biographies, actualités et performances des plus grandes stars du baseball.';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <!-- Header -->
    <header class="page-header">
      <h1 class="page-title">Joueurs Stars MLB</h1>
      <p class="page-description">
        Les 200 plus grandes stars de la Major League Baseball
      </p>
    </header>

    <!-- Filters (placeholder for V2) -->
    <div class="filters">
      <div class="filter-group">
        <label>Position</label>
        <select class="filter-select">
          <option>Toutes</option>
          <option>Lanceurs</option>
          <option>Batteurs</option>
          <option>Voltigeurs</option>
        </select>
      </div>
      <div class="filter-group">
        <label>Équipe</label>
        <select class="filter-select">
          <option>Toutes</option>
        </select>
      </div>
    </div>

    <!-- Players Grid -->
    <div class="players-grid">
      {players.map((player: any) => (
        <a
          href={`/mlb/joueurs/${player.fullName.toLowerCase().replace(/\s+/g, '-')}/`}
          class="player-card"
        >
          <div class="player-card-header">
            {player.currentTeam && (
              <div class="player-team-logo">
                <img
                  src={getMLBLogo(player.currentTeam.id)}
                  alt={player.currentTeam.name}
                  loading="lazy"
                />
              </div>
            )}
          </div>

          <div class="player-card-body">
            <h3 class="player-name">{player.fullName}</h3>
            <div class="player-meta">
              <span class="player-team">{player.currentTeam?.name || 'Free Agent'}</span>
              <span class="player-position">{player.primaryPosition?.abbreviation || 'N/A'}</span>
            </div>
            <div class="player-number">#{player.primaryNumber || '--'}</div>
          </div>
        </a>
      ))}
    </div>

    <!-- Load More (placeholder) -->
    <div class="load-more">
      <button class="load-more-btn" disabled>
        Charger plus de joueurs
      </button>
      <p class="load-more-text">Affichage de {players.length} joueurs sur 200</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
    text-align: center;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .filters {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .filter-group label {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .filter-select {
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text);
    cursor: pointer;
  }

  .players-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .player-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .player-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  .player-card-header {
    height: 80px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .player-team-logo {
    width: 60px;
    height: 60px;
    background: white;
    border-radius: 50%;
    padding: var(--space-2);
    box-shadow: var(--shadow-md);
  }

  .player-team-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .player-card-body {
    padding: var(--space-4);
  }

  .player-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .player-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .player-team {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .player-position {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-primary);
    text-transform: uppercase;
    background: var(--color-bg);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .player-number {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-extrabold);
    color: var(--color-primary);
    opacity: 0.3;
  }

  .load-more {
    text-align: center;
    padding: var(--space-6);
  }

  .load-more-btn {
    padding: var(--space-3) var(--space-6);
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .load-more-btn:hover:not(:disabled) {
    background: var(--color-secondary);
  }

  .load-more-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .load-more-text {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .filters {
      flex-direction: column;
    }

    .players-grid {
      grid-template-columns: 1fr;
    }

    .page-title {
      font-size: var(--text-3xl);
    }
  }
</style>
