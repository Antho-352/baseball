---
/**
 * MLB Team Detail Page
 * Dynamic route for individual team pages
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getMLBLogo } from '@lib/constants/logos';

export async function getStaticPaths() {
  // Fetch all teams
  const response = await fetch('https://statsapi.mlb.com/api/v1/teams?sportId=1&season=2026');
  const data = await response.json();
  const teams = data.teams || [];

  return teams.map((team: any) => {
    const slug = team.name.toLowerCase().replace(/\s+/g, '-');
    return {
      params: { slug },
      props: { teamId: team.id, teamName: team.name, slug }
    };
  });
}

const { teamId, teamName, slug } = Astro.props;

// Fetch team details
async function fetchTeamDetails(teamId: number) {
  try {
    const [teamRes, rosterRes] = await Promise.all([
      fetch(`https://statsapi.mlb.com/api/v1/teams/${teamId}`),
      fetch(`https://statsapi.mlb.com/api/v1/teams/${teamId}/roster?rosterType=active`)
    ]);

    const team = await teamRes.json();
    const roster = await rosterRes.json();

    return {
      team: team.teams?.[0] || {},
      roster: roster.roster || []
    };
  } catch (error) {
    console.error(`Failed to fetch team ${teamId}:`, error);
    return { team: {}, roster: [] };
  }
}

const { team, roster } = await fetchTeamDetails(teamId);

const title = `${teamName} : Roster, Stats et Actualités MLB`;
const description = `Page officielle ${teamName} : effectif complet, statistiques de la saison, calendrier des matchs et dernières actualités.`;
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <!-- Team Header -->
    <header class="team-header">
      <div class="team-header-content">
        <div class="team-logo-large">
          <img src={getMLBLogo(teamId)} alt={teamName} />
        </div>
        <div class="team-header-info">
          <h1 class="team-name">{teamName}</h1>
          <div class="team-meta">
            <span class="team-division">{team.division?.name || ''}</span>
            <span class="team-venue">{team.venue?.name || ''}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="team-layout">
      <!-- Main Content -->
      <main class="team-main">
        <!-- Roster Section -->
        <section class="team-section">
          <h2 class="section-title">Effectif actif ({roster.length} joueurs)</h2>

          <div class="roster-grid">
            {roster.slice(0, 10).map((player: any) => (
              <div class="roster-card">
                <div class="player-number">#{player.jerseyNumber || '--'}</div>
                <div class="player-info">
                  <h3 class="player-name">{player.person.fullName}</h3>
                  <p class="player-position">{player.position.abbreviation}</p>
                </div>
              </div>
            ))}
          </div>

          {roster.length > 10 && (
            <p class="roster-more">
              <a href={`/mlb/equipes/${slug}/roster/`}>
                Voir l'effectif complet ({roster.length} joueurs) →
              </a>
            </p>
          )}
        </section>

        <!-- Stats Section -->
        <section class="team-section">
          <h2 class="section-title">Statistiques saison 2026</h2>
          <div class="stats-placeholder">
            <p>Statistiques détaillées à venir...</p>
          </div>
        </section>
      </main>

      <!-- Sidebar -->
      <aside class="team-sidebar">
        <!-- Team Info Widget -->
        <div class="widget">
          <h3 class="widget-title">Informations</h3>
          <div class="widget-content">
            <dl class="team-info-list">
              <div class="info-item">
                <dt>Division</dt>
                <dd>{team.division?.name || 'N/A'}</dd>
              </div>
              <div class="info-item">
                <dt>Stade</dt>
                <dd>{team.venue?.name || 'N/A'}</dd>
              </div>
              <div class="info-item">
                <dt>Ville</dt>
                <dd>{team.locationName || 'N/A'}</dd>
              </div>
              <div class="info-item">
                <dt>Fondation</dt>
                <dd>{team.firstYearOfPlay || 'N/A'}</dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Quick Links Widget -->
        <div class="widget">
          <h3 class="widget-title">Liens rapides</h3>
          <div class="widget-content">
            <nav class="quick-links">
              <a href={`/mlb/equipes/${slug}/roster/`}>Effectif complet</a>
              <a href={`/mlb/equipes/${slug}/stats/`}>Statistiques</a>
              <a href={`/mlb/equipes/${slug}/calendrier/`}>Calendrier</a>
              <a href={`/mlb/equipes/${slug}/news/`}>Actualités</a>
            </nav>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .team-header {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .team-header-content {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .team-logo-large {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
  }

  .team-logo-large img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .team-name {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .team-meta {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .team-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-6);
  }

  .team-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-border);
  }

  .roster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-2);
  }

  .roster-card {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .roster-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .player-number {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: white;
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
  }

  .player-name {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .player-position {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .roster-more {
    margin-top: var(--space-3);
    text-align: center;
  }

  .roster-more a {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
    text-decoration: none;
  }

  .roster-more a:hover {
    text-decoration: underline;
  }

  .stats-placeholder {
    padding: var(--space-8);
    text-align: center;
    color: var(--color-text-muted);
  }

  /* Sidebar */
  .widget {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .widget-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .team-info-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .info-item {
    display: flex;
    justify-content: space-between;
    padding: var(--space-2);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }

  .info-item dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: var(--font-medium);
  }

  .info-item dd {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: var(--font-semibold);
    text-align: right;
  }

  .quick-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .quick-links a {
    padding: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
  }

  .quick-links a:hover {
    background: var(--color-bg);
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .team-layout {
      grid-template-columns: 1fr;
    }

    .team-sidebar {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .team-header-content {
      flex-direction: column;
      text-align: center;
    }

    .team-name {
      font-size: var(--text-2xl);
    }

    .roster-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
