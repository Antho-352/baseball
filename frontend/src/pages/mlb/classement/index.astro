---

<BaseLayout
  title="Classement MLB - American League et National League | home-run.fr"
  description="Classements complets de la MLB par division. Suivez les positions de toutes les équipes en American League et National League."
>
  <div class="classement-page">
    <div class="container">
      <!-- Hero -->
      <div class="page-hero">
        <div class="breadcrumb">
          <a href="/">Accueil</a> / <a href="/mlb/">MLB</a> / <span>Classement</span>
        </div>
        <h1 class="page-title">CLASSEMENT MLB</h1>
        <p class="page-subtitle">Saison 2026 - Classements mis à jour quotidiennement</p>
      </div>

      <!-- American League -->
      <section class="league-section">
        <h2 class="league-title">🇺🇸 AMERICAN LEAGUE</h2>

        <div class="divisions-grid">
          <!-- AL East -->
          <div class="division-block">
            <h3 class="division-title">AL East</h3>
            <table class="standings-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Équipe</th>
                  <th>V</th>
                  <th>D</th>
                  <th>%</th>
                  <th>GB</th>
                </tr>
              </thead>
              <tbody>
                {americanLeague.east.map(team => (
                  <tr>
                    <td>{team.rank}</td>
                    <td>{team.teamName}</td>
                    <td>{team.wins}</td>
                    <td>{team.losses}</td>
                    <td>{team.pct.toFixed(3)}</td>
                    <td>{team.gb === 0 ? '-' : team.gb}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- AL Central -->
          <div class="division-block">
            <h3 class="division-title">AL Central</h3>
            <table class="standings-table">
              <thead>
                <tr><th>#</th><th>Équipe</th><th>V</th><th>D</th><th>%</th><th>GB</th></tr>
              </thead>
              <tbody>
                {americanLeague.central.map(team => (
                  <tr>
                    <td>{team.rank}</td><td>{team.teamName}</td><td>{team.wins}</td>
                    <td>{team.losses}</td><td>{team.pct.toFixed(3)}</td>
                    <td>{team.gb === 0 ? '-' : team.gb}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- AL West -->
          <div class="division-block">
            <h3 class="division-title">AL West</h3>
            <table class="standings-table">
              <thead>
                <tr><th>#</th><th>Équipe</th><th>V</th><th>D</th><th>%</th><th>GB</th></tr>
              </thead>
              <tbody>
                {americanLeague.west.map(team => (
                  <tr>
                    <td>{team.rank}</td><td>{team.teamName}</td><td>{team.wins}</td>
                    <td>{team.losses}</td><td>{team.pct.toFixed(3)}</td>
                    <td>{team.gb === 0 ? '-' : team.gb}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- National League -->
      <section class="league-section">
        <h2 class="league-title">🇺🇸 NATIONAL LEAGUE</h2>

        <div class="divisions-grid">
          <!-- NL East -->
          <div class="division-block">
            <h3 class="division-title">NL East</h3>
            <table class="standings-table">
              <thead>
                <tr><th>#</th><th>Équipe</th><th>V</th><th>D</th><th>%</th><th>GB</th></tr>
              </thead>
              <tbody>
                {nationalLeague.east.map(team => (
                  <tr>
                    <td>{team.rank}</td><td>{team.teamName}</td><td>{team.wins}</td>
                    <td>{team.losses}</td><td>{team.pct.toFixed(3)}</td>
                    <td>{team.gb === 0 ? '-' : team.gb}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- NL Central -->
          <div class="division-block">
            <h3 class="division-title">NL Central</h3>
            <table class="standings-table">
              <thead>
                <tr><th>#</th><th>Équipe</th><th>V</th><th>D</th><th>%</th><th>GB</th></tr>
              </thead>
              <tbody>
                {nationalLeague.central.map(team => (
                  <tr>
                    <td>{team.rank}</td><td>{team.teamName}</td><td>{team.wins}</td>
                    <td>{team.losses}</td><td>{team.pct.toFixed(3)}</td>
                    <td>{team.gb === 0 ? '-' : team.gb}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- NL West -->
          <div class="division-block">
            <h3 class="division-title">NL West</h3>
            <table class="standings-table">
              <thead>
                <tr><th>#</th><th>Équipe</th><th>V</th><th>D</th><th>%</th><th>GB</th></tr>
              </thead>
              <tbody>
                {nationalLeague.west.map(team => (
                  <tr>
                    <td>{team.rank}</td><td>{team.teamName}</td><td>{team.wins}</td>
                    <td>{team.losses}</td><td>{team.pct.toFixed(3)}</td>
                    <td>{team.gb === 0 ? '-' : team.gb}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Légende -->
      <div class="legend">
        <h3 class="legend-title">Légende</h3>
        <div class="legend-items">
          <div class="legend-item">
            <span class="legend-label">V :</span>
            <span class="legend-desc">Victoires</span>
          </div>
          <div class="legend-item">
            <span class="legend-label">D :</span>
            <span class="legend-desc">Défaites</span>
          </div>
          <div class="legend-item">
            <span class="legend-label">% :</span>
            <span class="legend-desc">Pourcentage de victoires</span>
          </div>
          <div class="legend-item">
            <span class="legend-label">GB :</span>
            <span class="legend-desc">Games Behind (retard sur le leader)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .classement-page {
    padding: 16px 0 48px 0;
  }

  /* Hero */
  .page-hero {
    margin-bottom: 32px;
  }

  .breadcrumb {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .breadcrumb a:hover {
    color: var(--color-red);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -1px;
    background: linear-gradient(135deg, #e8102e 0%, #ff6b9d 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
  }

  .page-subtitle {
    font-size: 16px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 32px;
    }
  }

  /* League sections */
  .league-section {
    margin-bottom: 48px;
  }

  .league-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.5px;
    color: var(--color-text);
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-border);
  }

  /* Divisions grid */
  .divisions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .divisions-grid {
      grid-template-columns: 1fr;
    }
  }

  .division-block {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .division-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: white;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    padding: var(--space-3);
    margin: 0;
  }

  .standings-table {
    width: 100%;
    border-collapse: collapse;
  }

  .standings-table thead {
    background: var(--color-bg);
  }

  .standings-table th {
    padding: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    text-align: left;
    text-transform: uppercase;
  }

  .standings-table td {
    padding: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .standings-table tbody tr:last-child td {
    border-bottom: none;
  }

  .standings-table tbody tr:hover {
    background: var(--color-bg);
  }

  /* Légende */
  .legend {
    margin-top: 48px;
    padding: 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .legend-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    margin-bottom: 16px;
  }

  .legend-items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .legend-item {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .legend-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-text);
  }

  .legend-desc {
    font-size: 13px;
    color: var(--color-text-muted);
  }
</style>
