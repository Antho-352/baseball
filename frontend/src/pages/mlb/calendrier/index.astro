---
/**
 * MLB Calendar Page
 * Full season schedule with filters
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getMLBLogo } from '@lib/constants/logos';

// Fetch schedule from MLB API
async function fetchSchedule() {
  try {
    const today = new Date().toISOString().split('T')[0];
    const response = await fetch(
      `https://statsapi.mlb.com/api/v1/schedule?sportId=1&startDate=${today}&endDate=2026-10-31&hydrate=team`
    );
    const data = await response.json();
    return data.dates || [];
  } catch (error) {
    console.error('Failed to fetch schedule:', error);
    return [];
  }
}

const schedule = await fetchSchedule();

// Group games by date
const gamesByDate = schedule.map((dateEntry: any) => ({
  date: dateEntry.date,
  games: dateEntry.games || []
}));

const title = 'Calendrier MLB 2026 : Tous les matchs de la saison';
const description = 'Calendrier complet de la saison MLB 2026. Consultez tous les matchs, horaires et résultats de la Major League Baseball.';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <!-- Header -->
    <header class="page-header">
      <h1 class="page-title">Calendrier MLB 2026</h1>
      <p class="page-description">
        Tous les matchs de la saison régulière
      </p>
    </header>

    <!-- Filters -->
    <div class="calendar-filters">
      <div class="filter-group">
        <label>Mois</label>
        <select class="filter-select">
          <option>Tous</option>
          <option>Avril</option>
          <option>Mai</option>
          <option>Juin</option>
          <option>Juillet</option>
          <option>Août</option>
          <option>Septembre</option>
          <option>Octobre</option>
        </select>
      </div>

      <div class="filter-group">
        <label>Équipe</label>
        <select class="filter-select">
          <option>Toutes les équipes</option>
        </select>
      </div>

      <div class="filter-group">
        <label>Affichage</label>
        <div class="view-toggle">
          <button class="view-btn view-btn--active">Liste</button>
          <button class="view-btn">Grille</button>
        </div>
      </div>
    </div>

    <!-- Calendar -->
    <div class="calendar-container">
      {gamesByDate.slice(0, 30).map((dateEntry: any) => (
        <section class="calendar-date-section">
          <h2 class="date-header">
            {new Date(dateEntry.date).toLocaleDateString('fr-FR', {
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            })}
          </h2>

          <div class="games-list">
            {dateEntry.games.map((game: any) => {
              const homeTeam = game.teams.home;
              const awayTeam = game.teams.away;
              const gameTime = new Date(game.gameDate);

              return (
                <div class="game-row">
                  <div class="game-time">
                    {gameTime.toLocaleTimeString('fr-FR', {
                      hour: '2-digit',
                      minute: '2-digit'
                    })}
                  </div>

                  <div class="game-matchup">
                    <div class="game-team">
                      <img
                        src={getMLBLogo(awayTeam.team.id)}
                        alt={awayTeam.team.name}
                        class="team-logo-small"
                        loading="lazy"
                      />
                      <span class="team-name">{awayTeam.team.name}</span>
                      {game.status.detailedState === 'Final' && (
                        <span class="team-score">{awayTeam.score}</span>
                      )}
                    </div>

                    <span class="game-vs">@</span>

                    <div class="game-team">
                      <img
                        src={getMLBLogo(homeTeam.team.id)}
                        alt={homeTeam.team.name}
                        class="team-logo-small"
                        loading="lazy"
                      />
                      <span class="team-name">{homeTeam.team.name}</span>
                      {game.status.detailedState === 'Final' && (
                        <span class="team-score">{homeTeam.score}</span>
                      )}
                    </div>
                  </div>

                  <div class="game-status">
                    <span class={`status-badge status-${game.status.statusCode.toLowerCase()}`}>
                      {game.status.detailedState}
                    </span>
                  </div>

                  <div class="game-venue">
                    {game.venue?.name || 'Venue TBD'}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))}

      {gamesByDate.length === 0 && (
        <div class="no-games">
          <p>Aucun match planifié pour cette période.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
    text-align: center;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .calendar-filters {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .filter-group label {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .filter-select {
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text);
    cursor: pointer;
  }

  .view-toggle {
    display: flex;
    gap: var(--space-1);
  }

  .view-btn {
    flex: 1;
    padding: var(--space-2);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .view-btn:hover {
    background: var(--color-surface);
  }

  .view-btn--active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .calendar-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .calendar-date-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .date-header {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: white;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    padding: var(--space-3) var(--space-4);
    text-transform: capitalize;
  }

  .games-list {
    display: flex;
    flex-direction: column;
  }

  .game-row {
    display: grid;
    grid-template-columns: 80px 1fr auto 200px;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-base);
  }

  .game-row:last-child {
    border-bottom: none;
  }

  .game-row:hover {
    background: var(--color-bg);
  }

  .game-time {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  .game-matchup {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .game-team {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: 1;
  }

  .team-logo-small {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .team-name {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .team-score {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-extrabold);
    color: var(--color-primary);
    margin-left: auto;
  }

  .game-vs {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
  }

  .game-status {
    text-align: center;
  }

  .status-badge {
    display: inline-block;
    padding: 4px 12px;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    border-radius: var(--radius-md);
    text-transform: uppercase;
  }

  .status-s {
    background: var(--color-bg);
    color: var(--color-text-muted);
  }

  .status-l,
  .status-i {
    background: var(--color-error);
    color: white;
    animation: pulse 2s infinite;
  }

  .status-f {
    background: var(--color-success);
    color: white;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .game-venue {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: right;
  }

  .no-games {
    padding: var(--space-12);
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .no-games p {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .game-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .game-time,
    .game-status,
    .game-venue {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .calendar-filters {
      flex-direction: column;
    }

    .page-title {
      font-size: var(--text-3xl);
    }
  }
</style>
