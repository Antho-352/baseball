---
/**
 * MLB Hitters Stats Page
 * Top batting leaders for the season
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getMLBLogo } from '@lib/constants/logos';

// Fetch hitting leaders from MLB API
async function fetchHittingLeaders() {
  try {
    const categories = ['homeRuns', 'battingAverage', 'runsBattedIn', 'hits', 'stolenBases', 'onBasePlusSlugging'];

    const leaders = await Promise.all(
      categories.map(async (category) => {
        const response = await fetch(
          `https://statsapi.mlb.com/api/v1/stats/leaders?leaderCategories=${category}&season=2026&sportId=1&limit=10&hydrate=person,team`
        );
        const data = await response.json();
        return {
          category,
          leaders: data.leagueLeaders?.[0]?.leaders || []
        };
      })
    );

    return leaders;
  } catch (error) {
    console.error('Failed to fetch hitting leaders:', error);
    return [];
  }
}

const leadersByCategory = await fetchHittingLeaders();

// Get HR leaders for main display
const hrLeaders = leadersByCategory.find(c => c.category === 'homeRuns')?.leaders || [];

const title = 'Stats Batteurs MLB 2026 : Classements et Leaders';
const description = 'Classement des meilleurs batteurs MLB 2026 : home runs, moyenne au bâton, RBI, hits, bases volées. Stats complètes et leaders par catégorie.';
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <!-- Header -->
    <header class="page-header">
      <h1 class="page-title">Stats Batteurs MLB 2026</h1>
      <p class="page-description">
        Leaders et classements de la saison régulière
      </p>
    </header>

    <!-- Category Tabs -->
    <div class="category-tabs">
      <button class="category-tab category-tab--active" data-category="homeRuns">
        Home Runs
      </button>
      <button class="category-tab" data-category="battingAverage">
        Moyenne
      </button>
      <button class="category-tab" data-category="runsBattedIn">
        RBI
      </button>
      <button class="category-tab" data-category="hits">
        Hits
      </button>
      <button class="category-tab" data-category="stolenBases">
        Bases volées
      </button>
      <button class="category-tab" data-category="onBasePlusSlugging">
        OPS
      </button>
    </div>

    <!-- Leaders Tables -->
    <div class="leaders-container">
      {leadersByCategory.map((categoryData) => (
        <div
          class={`leaders-table ${categoryData.category === 'homeRuns' ? 'leaders-table--visible' : ''}`}
          data-category={categoryData.category}
        >
          <div class="table-wrapper">
            <table class="stats-table">
              <thead>
                <tr>
                  <th class="rank-col">#</th>
                  <th class="player-col">Joueur</th>
                  <th class="team-col">Équipe</th>
                  <th class="stat-col">
                    {categoryData.category === 'homeRuns' && 'HR'}
                    {categoryData.category === 'battingAverage' && 'AVG'}
                    {categoryData.category === 'runsBattedIn' && 'RBI'}
                    {categoryData.category === 'hits' && 'H'}
                    {categoryData.category === 'stolenBases' && 'SB'}
                    {categoryData.category === 'onBasePlusSlugging' && 'OPS'}
                  </th>
                  <th class="extra-col">AB</th>
                  <th class="extra-col">G</th>
                </tr>
              </thead>
              <tbody>
                {categoryData.leaders.map((leader: any, index: number) => (
                  <tr class="stats-row">
                    <td class="rank-col">
                      <span class={`rank-badge ${index < 3 ? `rank-${index + 1}` : ''}`}>
                        {leader.rank}
                      </span>
                    </td>
                    <td class="player-col">
                      <a
                        href={`/mlb/joueurs/${leader.person?.fullName?.toLowerCase().replace(/\s+/g, '-')}/`}
                        class="player-link"
                      >
                        {leader.person?.fullName || 'N/A'}
                      </a>
                    </td>
                    <td class="team-col">
                      {leader.team && (
                        <div class="team-info">
                          <img
                            src={getMLBLogo(leader.team.id)}
                            alt={leader.team.name}
                            class="team-logo-tiny"
                            loading="lazy"
                          />
                          <span>{leader.team.abbreviation}</span>
                        </div>
                      )}
                    </td>
                    <td class="stat-col">
                      <strong>{leader.value}</strong>
                    </td>
                    <td class="extra-col">{leader.atBats || '-'}</td>
                    <td class="extra-col">{leader.gamesPlayed || '-'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>

    <!-- Quick Stats Summary -->
    <section class="summary-section">
      <h2 class="section-title">En bref</h2>
      <div class="summary-grid">
        <div class="summary-card">
          <div class="summary-label">Leader HR</div>
          <div class="summary-value">{hrLeaders[0]?.person?.fullName || 'N/A'}</div>
          <div class="summary-stat">{hrLeaders[0]?.value || '0'} home runs</div>
        </div>
        <div class="summary-card">
          <div class="summary-label">Top AVG</div>
          <div class="summary-value">
            {leadersByCategory.find(c => c.category === 'battingAverage')?.leaders[0]?.person?.fullName || 'N/A'}
          </div>
          <div class="summary-stat">
            {leadersByCategory.find(c => c.category === 'battingAverage')?.leaders[0]?.value || '.---'}
          </div>
        </div>
        <div class="summary-card">
          <div class="summary-label">Leader RBI</div>
          <div class="summary-value">
            {leadersByCategory.find(c => c.category === 'runsBattedIn')?.leaders[0]?.person?.fullName || 'N/A'}
          </div>
          <div class="summary-stat">
            {leadersByCategory.find(c => c.category === 'runsBattedIn')?.leaders[0]?.value || '0'} RBI
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
    text-align: center;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .category-tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    overflow-x: auto;
  }

  .category-tab {
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  .category-tab:hover {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .category-tab--active {
    background: var(--color-primary);
    color: white;
  }

  .leaders-container {
    position: relative;
    margin-bottom: var(--space-8);
  }

  .leaders-table {
    display: none;
  }

  .leaders-table--visible {
    display: block;
  }

  .table-wrapper {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .stats-table {
    width: 100%;
    border-collapse: collapse;
  }

  .stats-table thead {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    color: white;
  }

  .stats-table th {
    padding: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-align: left;
    text-transform: uppercase;
  }

  .stats-table td {
    padding: var(--space-3);
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .stats-row:last-child td {
    border-bottom: none;
  }

  .stats-row:hover {
    background: var(--color-bg);
  }

  .rank-col {
    width: 60px;
    text-align: center;
  }

  .rank-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  .rank-1 {
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    color: white;
  }

  .rank-2 {
    background: linear-gradient(135deg, #C0C0C0 0%, #A8A8A8 100%);
    color: white;
  }

  .rank-3 {
    background: linear-gradient(135deg, #CD7F32 0%, #B87333 100%);
    color: white;
  }

  .player-col {
    min-width: 200px;
  }

  .player-link {
    color: var(--color-text);
    font-weight: var(--font-semibold);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .player-link:hover {
    color: var(--color-primary);
  }

  .team-col {
    width: 120px;
  }

  .team-info {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .team-logo-tiny {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .stat-col {
    width: 100px;
    text-align: center;
  }

  .stat-col strong {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-extrabold);
    color: var(--color-primary);
  }

  .extra-col {
    width: 80px;
    text-align: center;
    color: var(--color-text-muted);
  }

  .summary-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-border);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .summary-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-align: center;
  }

  .summary-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .summary-value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .summary-stat {
    font-size: var(--text-sm);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: var(--text-3xl);
    }

    .table-wrapper {
      overflow-x: auto;
    }

    .summary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Category tabs functionality
  const tabs = document.querySelectorAll('.category-tab');
  const tables = document.querySelectorAll('.leaders-table');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const category = tab.getAttribute('data-category');

      // Update active tab
      tabs.forEach(t => t.classList.remove('category-tab--active'));
      tab.classList.add('category-tab--active');

      // Show corresponding table
      tables.forEach(table => {
        if (table.getAttribute('data-category') === category) {
          table.classList.add('leaders-table--visible');
        } else {
          table.classList.remove('leaders-table--visible');
        }
      });
    });
  });
</script>
