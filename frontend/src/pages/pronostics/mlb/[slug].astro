---
/**
 * MLB Prediction Detail Page
 * Individual prediction page with analysis and betting odds
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getMLBLogo, getBookmakerLogo } from '@lib/constants/logos';

export async function getStaticPaths() {
  // Mock prediction data - will be from DB later
  const mockPredictions = [
    {
      slug: '2026-04-15-yankees-vs-red-sox',
      league: 'mlb',
      date: '2026-04-15T19:05:00Z',
      homeTeam: { name: 'New York Yankees', id: 147 },
      awayTeam: { name: 'Boston Red Sox', id: 111 },
      venue: 'Yankee Stadium',
      prediction: 'Yankees',
      confidence: 75,
      analysis: `
Les Yankees arrivent en forme avec 5 victoires sur leurs 7 derniers matchs. Aaron Judge et Juan Soto sont en feu
avec une moyenne combinée de .340 sur la dernière semaine. Gerrit Cole sera au monticule, avec une ERA de 2.45
contre Boston en carrière.

Les Red Sox traversent une période difficile avec 3 défaites consécutives. Leur attaque marque seulement 2.8 runs
de moyenne sur les 5 derniers matchs. Le lanceur partant Tanner Houck a une ERA de 4.80 au Yankee Stadium.

**Facteurs clés:**
- Yankees: 12-3 à domicile cette saison
- Cole vs Red Sox: 8-2, 2.45 ERA en carrière
- Judge: 8 HR en 15 matchs vs Boston cette saison
- Red Sox: 2-8 sur les 10 derniers matchs
`,
      odds: [
        { bookmaker: 'betclic', moneyline: { home: 1.65, away: 2.20 }, spread: { home: -1.5, homeOdds: 2.10, away: 1.5, awayOdds: 1.75 } },
        { bookmaker: 'unibet', moneyline: { home: 1.68, away: 2.15 }, spread: { home: -1.5, homeOdds: 2.05, away: 1.5, awayOdds: 1.78 } },
        { bookmaker: 'winamax', moneyline: { home: 1.70, away: 2.10 }, spread: { home: -1.5, homeOdds: 2.00, away: 1.5, awayOdds: 1.80 } },
      ],
      recommendation: {
        pick: 'Yankees Moneyline',
        stake: '3/5',
        reasoning: 'Avantage net à domicile avec Cole au monticule. Valeur correcte à 1.65-1.70.'
      }
    }
  ];

  // Will query DB for all published predictions
  return mockPredictions.map(pred => ({
    params: { slug: pred.slug },
    props: { prediction: pred }
  }));
}

const { prediction } = Astro.props;

const gameDate = new Date(prediction.date);
const title = `Pronostic ${prediction.awayTeam.name} vs ${prediction.homeTeam.name} - ${gameDate.toLocaleDateString('fr-FR')}`;
const description = `Analyse et pronostic détaillé pour ${prediction.awayTeam.name} @ ${prediction.homeTeam.name}. Statistiques, cotes bookmakers et recommandation.`;
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Accueil</a>
      <span>›</span>
      <a href="/pronostics/">Pronostics</a>
      <span>›</span>
      <a href="/pronostics/mlb/">MLB</a>
      <span>›</span>
      <span>{gameDate.toLocaleDateString('fr-FR')}</span>
    </nav>

    <!-- ANJ Warning -->
    <div class="warning-box">
      <div class="warning-icon">⚠️</div>
      <div class="warning-content">
        <strong>Jeu responsable :</strong> Jouer comporte des risques : endettement, dépendance...
        Pour obtenir de l'aide : <a href="https://www.joueurs-info-service.fr/" target="_blank" rel="noopener">joueurs-info-service.fr</a> | 09 74 75 13 13
      </div>
    </div>

    <div class="prediction-layout">
      <!-- Main Content -->
      <main class="prediction-main">
        <!-- Game Header -->
        <header class="game-header">
          <div class="game-meta">
            <span class="game-league">MLB</span>
            <span class="game-date">
              {gameDate.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
            <span class="game-time">
              {gameDate.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}
            </span>
          </div>

          <div class="game-matchup">
            <div class="game-team">
              <img src={getMLBLogo(prediction.awayTeam.id)} alt={prediction.awayTeam.name} class="team-logo-large" />
              <h2 class="team-name">{prediction.awayTeam.name}</h2>
              <span class="team-label">Visiteurs</span>
            </div>

            <div class="game-vs">
              <span>@</span>
            </div>

            <div class="game-team">
              <img src={getMLBLogo(prediction.homeTeam.id)} alt={prediction.homeTeam.name} class="team-logo-large" />
              <h2 class="team-name">{prediction.homeTeam.name}</h2>
              <span class="team-label">Domicile</span>
            </div>
          </div>

          <div class="game-venue">
            📍 {prediction.venue}
          </div>
        </header>

        <!-- Prediction Box -->
        <section class="prediction-box">
          <h3 class="prediction-title">Notre Pronostic</h3>
          <div class="prediction-pick">
            <div class="pick-team">{prediction.recommendation.pick}</div>
            <div class="pick-confidence">
              <span class="confidence-label">Confiance:</span>
              <div class="confidence-bar">
                <div class="confidence-fill" style={`width: ${prediction.confidence}%`}></div>
              </div>
              <span class="confidence-value">{prediction.confidence}%</span>
            </div>
            <div class="pick-stake">
              <span class="stake-label">Mise recommandée:</span>
              <span class="stake-value">{prediction.recommendation.stake}</span>
            </div>
          </div>
          <div class="pick-reasoning">
            {prediction.recommendation.reasoning}
          </div>
        </section>

        <!-- Analysis -->
        <section class="analysis-section">
          <h3 class="section-title">Analyse détaillée</h3>
          <div class="analysis-content" set:html={prediction.analysis.trim().split('\n\n').map(p => `<p>${p}</p>`).join('')} />
        </section>

        <!-- Odds Comparison -->
        <section class="odds-section">
          <h3 class="section-title">Comparaison des cotes</h3>

          <div class="odds-table-wrapper">
            <h4 class="odds-subtitle">Money Line (1X2)</h4>
            <table class="odds-table">
              <thead>
                <tr>
                  <th>Bookmaker</th>
                  <th>{prediction.awayTeam.name}</th>
                  <th>{prediction.homeTeam.name}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {prediction.odds.map(odd => (
                  <tr>
                    <td>
                      <div class="bookmaker-cell">
                        <img src={getBookmakerLogo(odd.bookmaker)} alt={odd.bookmaker} class="bookmaker-logo" />
                        <span>{odd.bookmaker.charAt(0).toUpperCase() + odd.bookmaker.slice(1)}</span>
                      </div>
                    </td>
                    <td><strong class="odd-value">{odd.moneyline.away}</strong></td>
                    <td><strong class="odd-value odd-value--best">{odd.moneyline.home}</strong></td>
                    <td>
                      <a href={`/paris-sportifs/${odd.bookmaker}/`} class="bet-btn" rel="nofollow sponsored">
                        Parier
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="odds-table-wrapper">
            <h4 class="odds-subtitle">Spread (-1.5 / +1.5)</h4>
            <table class="odds-table">
              <thead>
                <tr>
                  <th>Bookmaker</th>
                  <th>{prediction.awayTeam.name} (+1.5)</th>
                  <th>{prediction.homeTeam.name} (-1.5)</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {prediction.odds.map(odd => (
                  <tr>
                    <td>
                      <div class="bookmaker-cell">
                        <img src={getBookmakerLogo(odd.bookmaker)} alt={odd.bookmaker} class="bookmaker-logo" />
                        <span>{odd.bookmaker.charAt(0).toUpperCase() + odd.bookmaker.slice(1)}</span>
                      </div>
                    </td>
                    <td><strong class="odd-value">{odd.spread.awayOdds}</strong></td>
                    <td><strong class="odd-value">{odd.spread.homeOdds}</strong></td>
                    <td>
                      <a href={`/paris-sportifs/${odd.bookmaker}/`} class="bet-btn" rel="nofollow sponsored">
                        Parier
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Disclaimer -->
        <section class="disclaimer">
          <p><strong>Avertissement :</strong> Ce pronostic est fourni à titre informatif uniquement. Les paris sportifs comportent des risques financiers. Nous vous encourageons à parier de manière responsable et à ne jamais miser plus que ce que vous pouvez vous permettre de perdre.</p>
        </section>
      </main>

      <!-- Sidebar -->
      <aside class="prediction-sidebar">
        <!-- Best Bookmakers Widget -->
        <div class="widget">
          <h3 class="widget-title">Meilleurs sites pour parier</h3>
          <div class="widget-content">
            <div class="bookmakers-list">
              <a href="/paris-sportifs/betclic/" class="bookmaker-item" rel="nofollow sponsored">
                <img src={getBookmakerLogo('betclic')} alt="Betclic" class="bookmaker-logo" />
                <div class="bookmaker-info">
                  <strong>Betclic</strong>
                  <span class="bookmaker-bonus">100€ remboursés</span>
                </div>
              </a>
              <a href="/paris-sportifs/unibet/" class="bookmaker-item" rel="nofollow sponsored">
                <img src={getBookmakerLogo('unibet')} alt="Unibet" class="bookmaker-logo" />
                <div class="bookmaker-info">
                  <strong>Unibet</strong>
                  <span class="bookmaker-bonus">100€ offerts</span>
                </div>
              </a>
              <a href="/paris-sportifs/winamax/" class="bookmaker-item" rel="nofollow sponsored">
                <img src={getBookmakerLogo('winamax')} alt="Winamax" class="bookmaker-logo" />
                <div class="bookmaker-info">
                  <strong>Winamax</strong>
                  <span class="bookmaker-bonus">100€ CASH</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- Related Predictions -->
        <div class="widget">
          <h3 class="widget-title">Autres pronostics MLB</h3>
          <div class="widget-content">
            <p class="widget-empty">Autres pronostics à venir...</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .warning-box {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
    border: 2px solid var(--color-error);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-6);
  }

  .warning-icon {
    font-size: var(--text-2xl);
  }

  .warning-content {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .warning-content a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .prediction-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-6);
  }

  .game-header {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .game-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .game-league {
    padding: 4px 12px;
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border-radius: var(--radius-md);
    text-transform: uppercase;
  }

  .game-date {
    font-size: var(--text-sm);
    color: var(--color-text);
    text-transform: capitalize;
  }

  .game-time {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-primary);
  }

  .game-matchup {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .game-team {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .team-logo-large {
    width: 100px;
    height: 100px;
    object-fit: contain;
  }

  .team-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    text-align: center;
  }

  .team-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .game-vs {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text-muted);
  }

  .game-venue {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .prediction-box {
    background: linear-gradient(135deg, rgba(30, 58, 138, 0.05) 0%, rgba(220, 38, 38, 0.05) 100%);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .prediction-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .prediction-pick {
    background: white;
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .pick-team {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    color: var(--color-primary);
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .pick-confidence {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .confidence-label {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .confidence-bar {
    flex: 1;
    height: 12px;
    background: var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .confidence-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-success) 0%, var(--color-primary) 100%);
  }

  .confidence-value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-primary);
  }

  .pick-stake {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }

  .stake-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .stake-value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-success);
  }

  .pick-reasoning {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
  }

  .analysis-section,
  .odds-section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-border);
  }

  .analysis-content {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text);
  }

  .analysis-content p {
    margin-bottom: var(--space-4);
  }

  .odds-table-wrapper {
    margin-bottom: var(--space-6);
  }

  .odds-table-wrapper:last-child {
    margin-bottom: 0;
  }

  .odds-subtitle {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .odds-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-bg);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .odds-table thead {
    background: var(--color-surface);
  }

  .odds-table th {
    padding: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    text-align: left;
  }

  .odds-table td {
    padding: var(--space-3);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .odds-table td:first-child {
    text-align: left;
  }

  .bookmaker-cell {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .bookmaker-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .odd-value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-text);
  }

  .odd-value--best {
    color: var(--color-success);
  }

  .bet-btn {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary);
    color: white;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .bet-btn:hover {
    background: var(--color-secondary);
  }

  .disclaimer {
    padding: var(--space-4);
    background: var(--color-bg);
    border-left: 4px solid var(--color-warning);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Sidebar */
  .widget {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .widget-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .bookmakers-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .bookmaker-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .bookmaker-item:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .bookmaker-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .bookmaker-info strong {
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .bookmaker-bonus {
    font-size: var(--text-xs);
    color: var(--color-success);
    font-weight: var(--font-semibold);
  }

  .widget-empty {
    padding: var(--space-4);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .prediction-layout {
      grid-template-columns: 1fr;
    }

    .prediction-sidebar {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .game-matchup {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .game-vs {
      display: none;
    }

    .team-logo-large {
      width: 80px;
      height: 80px;
    }

    .team-name {
      font-size: var(--text-lg);
    }

    .odds-table {
      font-size: var(--text-sm);
    }
  }
</style>
