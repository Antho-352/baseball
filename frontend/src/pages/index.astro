---

<BaseLayout
  title="Baseball : Actualités, Stats et Pronostics | home-run.fr"
  description="Référence française du baseball professionnel. Suivez MLB, KBO et NPB : scores en direct, classements, stats complètes et pronostics."
>
  <!-- Ticker live -->
  <TickerTV items={tickerItems} speed={40} />

  <!-- Hero compact -->
  <div class="container">
    <section class="hero-compact">
      <h1 class="hero-title">
        HOME-RUN.FR : ACTUALITÉS BASEBALL, STATS & PRONOSTICS
      </h1>
      <!-- Stats inline compacts -->
      <div class="hero-stats-inline">
        <span class="stat-pill">⚾ 24 matchs</span>
        <span class="stat-pill">🔴 3 live</span>
        <span class="stat-pill">📊 12 pronostics</span>
      </div>
    </section>
  </div>

  <!-- Layout 70/30 (Main + Sidebar) -->
  <div class="homepage-layout">
    <div class="container">
      <div class="layout-grid">
        <!-- COLONNE PRINCIPALE (70%) -->
        <main class="main-content">
          <!-- Featured article (LCP critical) -->
          <article class="featured-article">
            <a href={`/news/${recentNews[0].slug}/`} class="featured-link">
              <div class="featured-image">
                <img
                  src={recentNews[0].imageUrl}
                  alt={recentNews[0].title}
                  width="800"
                  height="450"
                  loading="eager"
                  fetchpriority="high"
                />
                <div class="featured-overlay"></div>
                <div class="featured-badge" style={`background: ${recentNews[0].league === 'mlb' ? 'var(--color-mlb)' : recentNews[0].league === 'kbo' ? 'var(--color-kbo)' : 'var(--color-npb)'}`}>
                  {recentNews[0].league === 'mlb' && '🇺🇸 MLB'}
                  {recentNews[0].league === 'kbo' && '🇰🇷 KBO'}
                  {recentNews[0].league === 'npb' && '🇯🇵 NPB'}
                  · {recentNews[0].category}
                </div>
              </div>
              <div class="featured-content">
                <h2 class="featured-title">{recentNews[0].title}</h2>
                <p class="featured-excerpt">{recentNews[0].excerpt}</p>
                <div class="featured-meta">
                  <time>{new Date(recentNews[0].publishedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
                </div>
              </div>
            </a>
          </article>

          <!-- Bloc "Les cotes du jour" (SportyTrader-style) -->
          <section class="daily-odds-block">
            <h2 class="section-title">🎯 LES COTES DU JOUR</h2>

            <div class="odds-list">
              {dailyOdds.map((odd) => (
                <div class="odd-row">
                  <div class="match-info">
                    <span class="team">{odd.awayTeam}</span>
                    <span class="vs">vs</span>
                    <span class="team">{odd.homeTeam}</span>
                  </div>
                  <div class="odds-cta">
                    <a href={`${odd.affiliateUrl}?match=${odd.id}`} class="odd-btn">
                      {odd.awayOdd}
                    </a>
                    <span class="separator">-</span>
                    <a href={`${odd.affiliateUrl}?match=${odd.id}`} class={`odd-btn ${odd.isBestOdd ? 'highlighted' : ''}`}>
                      {odd.homeOdd}
                    </a>
                    <span class="bookmaker">
                      <img src={odd.bookmakerLogo} alt={odd.bookmaker} class="bookmaker-icon" />
                      {odd.bookmaker}
                    </span>
                  </div>
                </div>
              ))}
            </div>

            <ResponsibleGamblingNotice variant="inline" />
          </section>

          <!-- 6 articles récents (Grid 3 colonnes) -->
          <section class="news-grid-section">
            <div class="section-header">
              <h2 class="section-title">DERNIÈRES ACTUALITÉS</h2>
              <a href="/news/" class="section-link">Toutes les news →</a>
            </div>

            <div class="news-grid">
              {recentNews.slice(1).map((article) => (
                <article class="news-card">
                  <a href={`/news/${article.slug}/`} class="news-link">
                    <div class="news-image">
                      <img
                        src={article.imageUrl}
                        alt={article.title}
                        loading="lazy"
                      />
                    </div>
                    <div class="news-content">
                      <div class="news-meta">
                        <span class="news-category" style={`color: ${article.league === 'mlb' ? 'var(--color-mlb)' : article.league === 'kbo' ? 'var(--color-kbo)' : 'var(--color-npb)'}`}>
                          {article.league === 'mlb' && '🇺🇸 MLB'}
                          {article.league === 'kbo' && '🇰🇷 KBO'}
                          {article.league === 'npb' && '🇯🇵 NPB'}
                        </span>
                        <span class="news-date">{new Date(article.publishedAt).toLocaleDateString('fr-FR')}</span>
                      </div>
                      <h3 class="news-title">{article.title}</h3>
                      <p class="news-excerpt">{article.excerpt}</p>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        </main>

        <!-- SIDEBAR (30%) -->
        <aside class="sidebar">
          <div class="sidebar-sticky">
            <!-- Widget 1: Classements -->
            <div class="widget classements-widget">
              <h3 class="widget-title">📊 CLASSEMENTS</h3>

              <!-- League tabs -->
              <div class="league-tabs-compact">
                <button class="tab active" data-league="mlb">MLB</button>
                <button class="tab" data-league="kbo">KBO</button>
                <button class="tab" data-league="npb">NPB</button>
              </div>

              <!-- MLB content (with division select) -->
              <div class="standings-content active" data-league-content="mlb">
                <select class="division-select" id="mlb-division-select">
                  <option value="alEast">AL East</option>
                  <option value="alCentral">AL Central</option>
                  <option value="alWest">AL West</option>
                  <option value="nlEast">NL East</option>
                  <option value="nlCentral">NL Central</option>
                  <option value="nlWest">NL West</option>
                </select>

                <!-- AL East -->
                <table class="standings-compact division-table" data-division="alEast" style="display: table;">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Équipe</th>
                      <th>V</th>
                      <th>D</th>
                      <th>%</th>
                    </tr>
                  </thead>
                  <tbody>
                    {standings.mlb.alEast.map((team) => (
                      <tr>
                        <td>{team.rank}</td>
                        <td>
                          <img src={getMLBLogo(team.team)} alt={team.team} class="team-badge-logo" width="20" height="20" />
                          <strong>{team.team}</strong>
                        </td>
                        <td>{team.wins}</td>
                        <td>{team.losses}</td>
                        <td>{team.pct}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>

                <!-- AL Central -->
                <table class="standings-compact division-table" data-division="alCentral" style="display: none;">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Équipe</th>
                      <th>V</th>
                      <th>D</th>
                      <th>%</th>
                    </tr>
                  </thead>
                  <tbody>
                    {standings.mlb.alCentral.map((team) => (
                      <tr>
