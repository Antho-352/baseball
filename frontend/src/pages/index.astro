<script>
  // League tabs switching (Classements widget)
  const leagueTabs = document.querySelectorAll('.league-tabs-compact .tab');
  const standingsContents = document.querySelectorAll('.standings-content');

  leagueTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const league = tab.getAttribute('data-league');

      // Remove active from all tabs
      leagueTabs.forEach((t) => t.classList.remove('active'));
      // Add active to clicked tab
      tab.classList.add('active');

      // Hide all contents
      standingsContents.forEach((c) => c.classList.remove('active'));
      // Show selected league content
      const targetContent = document.querySelector(`[data-league-content="${league}"]`);
      if (targetContent) {
        targetContent.classList.add('active');
      }
    });
  });

  // Division select (MLB only)
  const divisionSelect = document.getElementById('mlb-division-select');
  if (divisionSelect) {
    divisionSelect.addEventListener('change', (e) => {
      const division = (e.target as HTMLSelectElement).value;

      // Hide all division tables
      const allTables = document.querySelectorAll('.division-table');
      allTables.forEach((table) => {
        (table as HTMLElement).style.display = 'none';
      });

      // Show selected division table
      const selectedTable = document.querySelector(`[data-division="${division}"]`);
      if (selectedTable) {
        (selectedTable as HTMLElement).style.display = 'table';
      }
    });
  }
</script>
