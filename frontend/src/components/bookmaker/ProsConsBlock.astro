---
/**
 * Pros/Cons Block Component
 * Displays advantages and disadvantages in a 2-column grid
 */

interface Props {
  pros: string[];
  cons: string[];
}

const { pros, cons } = Astro.props;
---

<section class="pros-cons-block">
  <div class="pros-cons-grid">
    <!-- Pros -->
    <div class="pros-column">
      <h3 class="column-title pros-title">
        <span class="title-icon">✅</span>
        <span class="title-text">Avantages</span>
      </h3>
      <ul class="pros-list">
        {pros.map(pro => (
          <li class="pros-item">{pro}</li>
        ))}
      </ul>
    </div>

    <!-- Cons -->
    <div class="cons-column">
      <h3 class="column-title cons-title">
        <span class="title-icon">❌</span>
        <span class="title-text">Inconvénients</span>
      </h3>
      <ul class="cons-list">
        {cons.map(con => (
          <li class="cons-item">{con}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .pros-cons-block {
    margin-bottom: var(--space-4);
  }

  .pros-cons-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
  }

  @media (max-width: 768px) {
    .pros-cons-grid {
      grid-template-columns: 1fr;
    }
  }

  .pros-column,
  .cons-column {
    padding: var(--space-2);
    border-radius: var(--radius-md);
  }

  .pros-column {
    background: rgba(16, 163, 74, 0.05);
    border: 1px solid rgba(16, 163, 74, 0.2);
  }

  .cons-column {
    background: rgba(220, 38, 38, 0.05);
    border: 1px solid rgba(220, 38, 38, 0.2);
  }

  .column-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .pros-title {
    color: var(--color-success);
  }

  .cons-title {
    color: var(--color-error);
  }

  .title-icon {
    font-size: 16px;
  }

  .pros-list,
  .cons-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pros-item,
  .cons-item {
    padding: 6px 0;
    padding-left: var(--space-3);
    position: relative;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .pros-item::before,
  .cons-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .pros-item::before {
    background: var(--color-success);
  }

  .cons-item::before {
    background: var(--color-error);
  }
</style>
