---
/**
 * Recent Articles Feed Widget
 *
 * Compact list of recent articles for sidebar
 * Format: thumbnail (60x60) on right, date + title on left
 * No internal scrollbar, uses page scroll
 */

interface Article {
  id: string;
  title: string;
  slug: string;
  publishedAt: string;
  imageUrl?: string;
  league?: 'mlb' | 'kbo' | 'npb';
}

interface Props {
  articles: Article[];
  limit?: number;
}

const { articles, limit = 10 } = Astro.props;
const displayArticles = articles.slice(0, limit);

// Format date relative (ex: "Il y a 2h", "Hier", "3 mars")
const formatRelativeDate = (dateString: string): string => {
  const date = new Date(dateString);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

  if (diffHours < 1) {
    const diffMins = Math.floor(diffMs / (1000 * 60));
    return `Il y a ${diffMins}min`;
  } else if (diffHours < 24) {
    return `Il y a ${diffHours}h`;
  } else if (diffDays === 1) {
    return 'Hier';
  } else if (diffDays < 7) {
    return `Il y a ${diffDays}j`;
  } else {
    return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
  }
};

// League color
const getLeagueColor = (league?: string) => {
  switch (league) {
    case 'mlb': return 'var(--color-mlb)';
    case 'kbo': return 'var(--color-kbo)';
    case 'npb': return 'var(--color-npb)';
    default: return 'var(--color-text-muted)';
  }
};
---

<div class="recent-feed">
  <div class="feed-list">
    {displayArticles.map((article) => (
      <a href={`/news/${article.slug}/`} class="feed-item">
        <div class="feed-content">
          <time class="feed-time" style={`color: ${getLeagueColor(article.league)}`}>
            {formatRelativeDate(article.publishedAt)}
          </time>
          <h4 class="feed-title">{article.title}</h4>
        </div>
        <div class="feed-thumbnail">
          <img
            src={article.imageUrl || '/images/news/placeholder.jpg'}
            alt={article.title}
            loading="lazy"
            width="60"
            height="60"
          />
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .recent-feed {
    width: 100%;
  }

  .feed-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .feed-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: background var(--transition-base);
  }

  .feed-item:hover {
    background: var(--color-surface-2);
  }

  .feed-content {
    flex: 1;
    min-width: 0;
  }

  .feed-time {
    display: block;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 4px;
  }

  .feed-title {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .feed-thumbnail {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-2);
  }

  .feed-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
