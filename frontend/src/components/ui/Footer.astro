---
/**
 * Footer Component
 * Includes ANJ legal warnings and site navigation
 */

const currentYear = new Date().getFullYear();

const footerLinks = {
  baseball: [
    { name: 'MLB', href: '/mlb/' },
    { name: 'KBO', href: '/kbo/' },
    { name: 'NPB', href: '/npb/' },
    { name: 'Pronostics', href: '/pronostics/' },
  ],
  legal: [
    { name: 'Mentions légales', href: '/mentions-legales/' },
    { name: 'Politique de confidentialité', href: '/politique-confidentialite/' },
    { name: 'Conditions d\'utilisation', href: '/conditions-utilisation/' },
    { name: 'Contact', href: '/contact/' },
  ],
  bookmakers: [
    { name: 'Betclic', href: '/paris-sportifs/betclic/' },
    { name: 'Unibet', href: '/paris-sportifs/unibet/' },
    { name: 'Winamax', href: '/paris-sportifs/winamax/' },
    { name: 'PMU', href: '/paris-sportifs/pmu/' },
  ],
  resources: [
    { name: 'News', href: '/news/' },
    { name: 'Calendrier', href: '/mlb/calendrier/' },
    { name: 'Classements', href: '/mlb/classement/' },
    { name: 'Stats', href: '/mlb/stats/batteurs/' },
  ],
};
---

<footer class="footer">
  <!-- ANJ Warning Banner -->
  <div class="anj-warning">
    <div class="container">
      <div class="anj-content">
        <div class="anj-icon">⚠️</div>
        <div class="anj-text">
          <p class="anj-main">
            <strong>Jeu responsable :</strong> Les jeux d'argent sont interdits aux mineurs.
            Jouer comporte des risques : endettement, dépendance...
          </p>
          <p class="anj-help">
            <strong>Pour obtenir de l'aide :</strong>
            <a href="https://www.joueurs-info-service.fr/" target="_blank" rel="noopener">joueurs-info-service.fr</a>
            | <a href="tel:0974751313">09 74 75 13 13</a> (appel non surtaxé)
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">
        <!-- About Section -->
        <div class="footer-column">
          <div class="footer-brand">
            <span class="brand-icon">⚾</span>
            <span class="brand-name">home-run.fr</span>
          </div>
          <p class="footer-description">
            Votre référence française pour le baseball professionnel : MLB, KBO, NPB.
            Scores en direct, statistiques, pronostics et actualités.
          </p>
          <div class="age-restriction">
            <div class="age-badge">18+</div>
            <span>Réservé aux adultes</span>
          </div>
        </div>

        <!-- Baseball Links -->
        <div class="footer-column">
          <h3 class="footer-title">Baseball</h3>
          <ul class="footer-links">
            {footerLinks.baseball.map(link => (
              <li><a href={link.href}>{link.name}</a></li>
            ))}
          </ul>
        </div>

        <!-- Resources Links -->
        <div class="footer-column">
          <h3 class="footer-title">Ressources</h3>
          <ul class="footer-links">
            {footerLinks.resources.map(link => (
              <li><a href={link.href}>{link.name}</a></li>
            ))}
          </ul>
        </div>

        <!-- Bookmakers Links -->
        <div class="footer-column">
          <h3 class="footer-title">Paris sportifs</h3>
          <ul class="footer-links">
            {footerLinks.bookmakers.map(link => (
              <li>
                <a href={link.href} rel="nofollow sponsored">{link.name}</a>
              </li>
            ))}
          </ul>
          <p class="footer-note">Opérateurs agréés ANJ</p>
        </div>

        <!-- Legal Links -->
        <div class="footer-column">
          <h3 class="footer-title">Légal</h3>
          <ul class="footer-links">
            {footerLinks.legal.map(link => (
              <li><a href={link.href}>{link.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-content">
        <p class="copyright">
          © {currentYear} home-run.fr - Tous droits réservés
        </p>
        <p class="disclaimer">
          Les cotes et informations sont fournies à titre indicatif uniquement.
          Nous ne sommes pas responsables des pertes liées aux paris sportifs.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  /* ANJ Warning */
  .anj-warning {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
    border-bottom: 2px solid var(--color-error);
    padding: var(--space-4) 0;
  }

  .anj-content {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .anj-icon {
    font-size: var(--text-3xl);
    flex-shrink: 0;
  }

  .anj-text {
    flex: 1;
  }

  .anj-main {
    font-size: var(--text-sm);
    color: var(--color-text);
    margin-bottom: var(--space-2);
    line-height: 1.6;
  }

  .anj-help {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .anj-help a {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: var(--font-semibold);
  }

  .anj-help a:hover {
    color: var(--color-secondary);
  }

  /* Main Footer */
  .footer-main {
    padding: var(--space-12) 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(4, 1fr);
    gap: var(--space-8);
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .brand-icon {
    font-size: var(--text-2xl);
  }

  .footer-description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .age-restriction {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .age-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--color-error);
    color: white;
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: var(--space-2);
  }

  /* Footer Bottom */
  .footer-bottom {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }

  .footer-bottom-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
  }

  .copyright {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .disclaimer {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-column:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .anj-content {
      flex-direction: column;
      text-align: center;
    }

    .footer-main {
      padding: var(--space-8) 0;
    }

    .footer-brand {
      justify-content: center;
    }

    .footer-description {
      text-align: center;
    }

    .age-restriction {
      justify-content: center;
    }
  }
</style>
